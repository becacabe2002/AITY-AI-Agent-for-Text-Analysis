# Copy to .env (gitignored) and fill in. Real environment variables win.

# --- BYOK keys for the opt-in live smoke suite (tests/smoke) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Database (compose.dev.yml) ---
# A plain postgresql:// URL is switched to the asyncpg driver automatically.
AITY_DATABASE_URL=postgresql://aity:aity-dev@127.0.0.1:5432/aity
# Opt-in DB tests (AITY_DB_TESTS=1) empty this database; its name must contain "test".
AITY_TEST_DATABASE_URL=postgresql://aity:aity-dev@127.0.0.1:5432/aity_test

# --- Uploads (W3 document service) ---
AITY_UPLOADS_DIR=./var/uploads

# --- Secrets (ADR-005): generate with `python scripts/generate_dev_secrets.py` ---
# Production reads /run/secrets/master.key and /run/secrets/jwt_secret.
AITY_MASTER_KEY_FILE=./var/secrets/master.key
AITY_JWT_SECRET_FILE=./var/secrets/jwt_secret
